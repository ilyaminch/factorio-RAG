# Скопировать на сервер в /mnt/storage/factorio-rag/.env и заполнить приватно.
MISTRAL_API_KEY=
MISTRAL_MODEL=gpt-6-luna
# Названия MISTRAL_* сохранены ради совместимости с модулем команды.
MISTRAL_BASE_URL=https://panel.safronspace.ru/v1
COLLECTION_NAME=factorio_wiki
EMBEDDING_MODEL=intfloat/multilingual-e5-large
VECTOR_SIZE=1024
TOP_K=4
HISTORY_TURNS=5
MAX_QUESTION_CHARS=1000
ANSWER_MAX_TOKENS=512
REWRITE_MAX_TOKENS=128
LLM_TIMEOUT_SECONDS=60
